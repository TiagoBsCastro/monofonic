+/* Read only the grid size N and box length from the white-noise file.
+ * This is called by node_rank 0; the caller broadcasts the result to the
+ * other ranks in the node.  Every HDF5 handle is checked and every error path
+ * closes the handles it has opened and frees the temporary allocations, so an
+ * early return cannot leak handles or memory. */
+int readFieldHeader(int *N, double *box_len, const char *fname, const char *dset_name) {
+    /* Suppress HDF5's automatic error stack so that expected failures (missing
+     * file, missing dataset) are reported cleanly by the caller. */
+    H5Eset_auto1(NULL, NULL);
+
+    hid_t h_file = H5Fopen(fname, H5F_ACC_RDONLY, H5P_DEFAULT);
+    if (h_file < 0) {
+        printf("Error: could not open white-noise file '%s'.\n", fname);
+        return 1;
+    }
+
+    /* Read the BoxSize attribute from the Header group if present. */
+    htri_t h_exists = H5Lexists(h_file, "/Header", H5P_DEFAULT);
+    if (h_exists < 0) {
+        H5Fclose(h_file);
+        return 1;
+    }
+    if (h_exists > 0) {
+        hid_t h_grp = H5Gopen(h_file, "Header", H5P_DEFAULT);
+        if (h_grp < 0) {
+            H5Fclose(h_file);
+            return 1;
+        }
+        hid_t h_attr = H5Aopen(h_grp, "BoxSize", H5P_DEFAULT);
+        if (h_attr < 0) {
+            H5Gclose(h_grp);
+            H5Fclose(h_file);
+            return 1;
+        }
+        double boxsize[3];
+        if (H5Aread(h_attr, H5T_NATIVE_DOUBLE, &boxsize) < 0) {
+            printf("Error reading hdf5 attribute '%s'.\n", "BoxSize");
+            H5Aclose(h_attr);
+            H5Gclose(h_grp);
+            H5Fclose(h_file);
+            return 1;
+        }
+        H5Aclose(h_attr);
+        H5Gclose(h_grp);
+        if (boxsize[0] != boxsize[1] || boxsize[1] != boxsize[2]) {
+            printf("Error: non-cubic box size (%g, %g, %g).\n", boxsize[0], boxsize[1], boxsize[2]);
+            H5Fclose(h_file);
+            return 2;
+        }
+        *box_len = boxsize[0];
+    }
+
+    /* Open the dataset and fetch the grid dimensions. */
+    hid_t h_data = H5Dopen2(h_file, dset_name, H5P_DEFAULT);
+    if (h_data < 0) {
+        printf("Error: could not open dataset '%s'.\n", dset_name);
+        H5Fclose(h_file);
+        return 1;
+    }
+    hid_t h_space = H5Dget_space(h_data);
+    if (h_space < 0) {
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 1;
+    }
+    int ndims = H5Sget_simple_extent_ndims(h_space);
+    if (ndims < 0) {
+        H5Sclose(h_space);
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 1;
+    }
+    hsize_t *dims = malloc(ndims * sizeof(hsize_t));
+    if (dims == NULL) {
+        H5Sclose(h_space);
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 1;
+    }
+    if (H5Sget_simple_extent_dims(h_space, dims, NULL) < 0) {
+        free(dims);
+        H5Sclose(h_space);
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 1;
+    }
+
+    /* It should be 3D and cubic (but allow padding in the last dimension). */
+    if (ndims != 3) {
+        printf("Number of dimensions %d != 3.\n", ndims);
+        free(dims);
+        H5Sclose(h_space);
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 2;
+    }
+    int read_N = (int)dims[0];
+    if (read_N != (int)dims[1] || (read_N != (int)dims[2] && (read_N + 2) != (int)dims[2])) {
+        printf("Non-cubic grid size (%lld, %lld, %lld).\n",
+               (long long)dims[0], (long long)dims[1], (long long)dims[2]);
+        free(dims);
+        H5Sclose(h_space);
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 2;
+    }
+    *N = read_N;
+
+    free(dims);
+    H5Sclose(h_space);
+    H5Dclose(h_data);
+    H5Fclose(h_file);
+
+    return 0;
+}
+
+/* Read the full N^3 white-noise field into a pre-allocated buffer.
+ * Called by node_rank 0; the field is then shared via a memory window. */
+int readFieldBody(double *box, const char *fname, const char *dset_name, int N) {
+    H5Eset_auto1(NULL, NULL);
+
+    hid_t h_file = H5Fopen(fname, H5F_ACC_RDONLY, H5P_DEFAULT);
+    if (h_file < 0) {
+        printf("Error: could not open white-noise file '%s'.\n", fname);
+        return 1;
+    }
+
+    hid_t h_data = H5Dopen2(h_file, dset_name, H5P_DEFAULT);
+    if (h_data < 0) {
+        printf("Error: could not open dataset '%s'.\n", dset_name);
+        H5Fclose(h_file);
+        return 1;
+    }
+    hid_t h_space = H5Dget_space(h_data);
+    if (h_space < 0) {
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 1;
+    }
+
+    /* The hyperslab that should be read (needed in case of padding). */
+    const hsize_t space_rank = 3;
+    const hsize_t space_dims[3] = {(hsize_t)N, (hsize_t)N, (hsize_t)N};
+    const hsize_t space_offset[3] = {0, 0, 0};
+
+    hid_t h_memspace = H5Screate_simple(space_rank, space_dims, NULL);
+    if (h_memspace < 0) {
+        H5Sclose(h_space);
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 1;
+    }
+    if (H5Sselect_hyperslab(h_space, H5S_SELECT_SET, space_offset, NULL, space_dims, NULL) < 0) {
+        H5Sclose(h_memspace);
+        H5Sclose(h_space);
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 1;
+    }
+
+    if (H5Dread(h_data, H5T_NATIVE_DOUBLE, h_memspace, h_space, H5P_DEFAULT, box) < 0) {
+        printf("Error reading hdf5 file '%s'.\n", fname);
+        H5Sclose(h_memspace);
+        H5Sclose(h_space);
+        H5Dclose(h_data);
+        H5Fclose(h_file);
+        return 1;
+    }
+
+    H5Sclose(h_memspace);
+    H5Sclose(h_space);
+    H5Dclose(h_data);
+    H5Fclose(h_file);
+
+    return 0;
+}
 
