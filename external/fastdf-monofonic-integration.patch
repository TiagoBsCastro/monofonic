 #include "../include/fastdf.h"
 
+/* Synchronize shared-memory access to the grid window.
+ *
+ * Shared grids are accessed through ordinary load/store operations.
+ *
+ * MPI_Win_sync + a node-local barrier is conceptually suitable for this usage
+ * under the unified memory model. However, the tested MPICH configuration
+ * returned MPI_ERR_RMA_SYNC for that implementation path.
+ *
+ * We therefore retain MPI_Win_fence here because it provides the required
+ * synchronization semantics on the MPI implementations tested for monofonIC.
+ * This is an implementation/portability choice rather than a requirement that
+ * MPI_Win_sync always needs an active exposure epoch. */
+static inline void shared_grid_sync(MPI_Win win, MPI_Comm comm) {
+    (void)comm;
+    MPI_Win_fence(0, win);
+}
+
+/* Count CPUs on which the node leader is actually allowed to execute.  This
+ * keeps the FFTW thread pool inside the process affinity mask when the MPI
+ * launcher pins ranks.  On non-Linux systems, retain the rank-local OpenMP
+ * thread count as the conservative fallback. */
+static int fastdf_allowed_cpu_count(int fallback) {
+#ifdef __linux__
+    cpu_set_t mask;
+    CPU_ZERO(&mask);
+    if (sched_getaffinity(0, sizeof(mask), &mask) == 0) {
+        int count = 0;
+        for (int cpu = 0; cpu < CPU_SETSIZE; cpu++)
+            count += CPU_ISSET(cpu, &mask) != 0;
+        if (count > 0)
+            return count;
+    }
+#endif
+    return fallback > 0 ? fallback : 1;
+}
+
+static void fastdf_destroy_fft_plans(fftw_plan *plans, size_t count) {
+    for (size_t i = 0; i < count; i++) {
+        if (plans[i] != NULL) {
+            fftw_destroy_plan(plans[i]);
+            plans[i] = NULL;
+        }
+    }
+}
+
+static int fastdf_size_add(size_t *total, size_t count) {
+    if (count > SIZE_MAX - *total)
+        return 1;
+    *total += count;
+    return 0;
+}
+
+static int fastdf_size_multiply(size_t left, size_t right, size_t *product) {
+    if (left != 0 && right > SIZE_MAX / left)
+        return 1;
+    *product = left * right;
+    return 0;
+}
+
+/* Publish the plain arrays extracted from CLASS in one node-local shared
+ * window. The structs and title-pointer arrays remain rank-local because a
+ * shared window is not required to have the same virtual address on every
+ * process. */
+static int fastdf_share_perturb_tables(MPI_Comm node_comm, int node_rank,
+                                       const struct perturb_data *leader_data,
+                                       const struct perturb_params *leader_params,
+                                       struct perturb_data *data,
+                                       struct perturb_params *params,
+                                       MPI_Win *shared_window) {
+    int dimensions[4] = {0, 0, 0, 0};
+    double cosmology[7] = {0};
+    if (node_rank == 0) {
+        dimensions[0] = leader_data->k_size;
+        dimensions[1] = leader_data->tau_size;
+        dimensions[2] = leader_data->n_functions;
+        dimensions[3] = leader_params->N_ncdm;
+        cosmology[0] = leader_params->T_CMB;
+        cosmology[1] = leader_params->h;
+        cosmology[2] = leader_params->Omega_lambda;
+        cosmology[3] = leader_params->Omega_k;
+        cosmology[4] = leader_params->Omega_m;
+        cosmology[5] = leader_params->Omega_b;
+        cosmology[6] = leader_params->Omega_ur;
+    }
+
+    int mpi_status = MPI_Bcast(dimensions, 4, MPI_INT, 0, node_comm);
+    if (mpi_status == MPI_SUCCESS)
+        mpi_status = MPI_Bcast(cosmology, 7, MPI_DOUBLE, 0, node_comm);
+    if (mpi_status != MPI_SUCCESS)
+        return 1;
+
+    const int k_size = dimensions[0];
+    const int tau_size = dimensions[1];
+    const int n_functions = dimensions[2];
+    const int n_ncdm = dimensions[3];
+    int local_failed = k_size <= 0 || tau_size <= 0 || n_functions <= 0 || n_ncdm < 0;
+    if (node_rank == 0) {
+        local_failed |= leader_data->k == NULL || leader_data->log_tau == NULL ||
+                        leader_data->redshift == NULL || leader_data->Hubble_H == NULL ||
+                        leader_data->delta == NULL || leader_data->Omega == NULL ||
