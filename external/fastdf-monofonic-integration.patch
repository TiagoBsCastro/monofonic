  *
  ******************************************************************************/
 
+/* sched_getaffinity() and the CPU_* macros are GNU/Linux extensions. */
+#if defined(__linux__) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE
+#endif
+
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <hdf5.h>
